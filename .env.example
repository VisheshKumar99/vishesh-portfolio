# ---------------------------------------------------------------------------
# Public site configuration. Copy to `.env.local` for local dev, or set these
# in your CI/CodeBuild environment. All values are exposed to the browser
# (NEXT_PUBLIC_*), so never put secrets here.
# ---------------------------------------------------------------------------

# Canonical site URL used for SEO metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://vishesh-portfolio.example.com

# Optional: GitHub username used for the (optional) GitHub activity section.
# If unset, the GitHub section renders from static config only — no API calls.
NEXT_PUBLIC_GITHUB_USERNAME=
